# Copy to backend/.env and fill in whichever provider you want to use.
# The app picks the first key it finds; pin one explicitly with LLM_PROVIDER.
# With no key set, the assistant still works using retrieval-only answers.

# --- Claude (Anthropic) ---
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# --- Gemini (Google AI Studio) ---
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI ---
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Force one provider even if several keys are present: claude | gemini | openai
# LLM_PROVIDER=claude

# --- OCR ---
# Tesseract must be installed on the host:
#   macOS:  brew install tesseract tesseract-lang
#   Ubuntu: apt-get install tesseract-ocr tesseract-ocr-vie
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
# TESSERACT_LANGS=vie+eng
# LLM
LLM_PROVIDER=gemini_mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# RAG / Qdrant. Use memory for zero-dependency local development, qdrant
# when the Docker service is running.
VECTOR_STORE_PROVIDER=memory
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=omniagent_knowledge

# hash is deterministic and needs no download. For production offline semantic
# search, pre-cache the model, then use local_sentence_transformers.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_DIMENSION=384

# OCR. Cloud is never used unless the request sends allow_external_ocr=true.
# Supported values: none, google, aws, auto.
OCR_CLOUD_PROVIDER=none
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
AWS_PROFILE=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional local OCR tuning
TESSERACT_CMD=
TESSERACT_LANGS=vie+eng
