# Copy to backend/.env and fill in whichever provider you want to use.
# The app picks the first key it finds; pin one explicitly with LLM_PROVIDER.
# With no key set, the assistant still works using retrieval-only answers.

# --- Claude (Anthropic) ---
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# --- Gemini (Google AI Studio) ---
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI ---
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Force one provider even if several keys are present: claude | gemini | openai
# LLM_PROVIDER=claude

# --- OCR ---
# Tesseract must be installed on the host:
#   macOS:  brew install tesseract tesseract-lang
#   Ubuntu: apt-get install tesseract-ocr tesseract-ocr-vie
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
# TESSERACT_LANGS=vie+eng
# --- Case bank storage ---
# Postgres keeps the statistics across restarts. Left empty, the bank uses a
# local SQLite file, which a deployed container erases on every restart.
# Neon (free tier): https://neon.tech
DATABASE_URL=

# Salt for the dedupe fingerprint. Generated and stored on disk when unset,
# which is fine for SQLite but not for Postgres: the rows outlive the container
# while a generated salt does not, so set a fixed random value in deployments.
#   python3 -c "import os; print(os.urandom(32).hex())"
LEGAL_CASE_BANK_SALT=

# --- Authentication & Security ---
# Secret key for JWT signing. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Default admin initial password on startup.
# Set a strong custom password for initial admin seeding.
DEFAULT_ADMIN_PASSWORD=

# --- RAG / vector store ---
# memory needs no dependencies. qdrant additionally requires `qdrant-client`,
# which is not installed by default — see requirements.txt.
VECTOR_STORE_PROVIDER=memory
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=omniagent_knowledge

# hash is deterministic and needs no download. local_sentence_transformers gives
# real semantic search but requires installing `sentence-transformers` (~2GB of
# torch, omitted from requirements.txt) and pre-caching the model.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_DIMENSION=384

# OCR. Cloud is never used unless the request sends allow_external_ocr=true.
# Supported values: none, google, aws, auto.
OCR_CLOUD_PROVIDER=none
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
AWS_PROFILE=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional local OCR tuning
TESSERACT_CMD=
TESSERACT_LANGS=vie+eng
